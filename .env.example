# AI
ANTHROPIC_API_KEY=

# News
NEWSAPI_KEY=

# Images
UNSPLASH_ACCESS_KEY=
USE_DALLE=false
OPENAI_API_KEY=        # only if USE_DALLE=true

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=   # urn:li:person:{id}
LINKEDIN_TOKEN_ISSUED_AT=  # YYYY-MM-DD, for expiry warnings

# Notion
NOTION_TOKEN=
NOTION_DATABASE_ID=

# Schedule
POST_SCHEDULE=MON,WED,FRI
POST_TIME_UTC=05:00    # 09:00 Dubai = 05:00 UTC
TIMEZONE=Asia/Dubai
DRY_RUN=false

# Goal 2: Image generation (Pollinations.ai is free/keyless — no key needed)
HUGGINGFACE_API_KEY=               # Unused in current implementation, reserved

# Goal 3: Content memory
CONTENT_MEMORY_LOOKBACK=20         # Number of recent posts to scan for dedup

# Goal 4: Interaction agent
ENGAGEMENT_THRESHOLD=10            # Reactions below this trigger boost comment after 24h
ENABLE_NETWORK_AGENT=false         # Phase B gate — do not change
